<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> - Threads</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #000;
      color: #fff;
      min-height: 100vh;
    }
    .container {
      display: flex;
      max-width: 1200px;
      margin: 0 auto;
      min-height: 100vh;
    }
    .sidebar {
      width: 280px;
      padding: 20px;
      position: sticky;
      top: 0;
      height: 100vh;
      border-right: 1px solid #2d2d2d;
    }
    .logo {
      font-size: 28px;
      font-weight: 700;
      padding: 20px 0 40px 10px;
      font-family: 'Georgia', serif;
    }
    .nav-item {
      display: flex;
      align-items: center;
      padding: 16px;
      font-size: 18px;
      border-radius: 30px;
      margin-bottom: 8px;
      cursor: pointer;
      transition: background 0.2s;
      text-decoration: none;
      color: #fff;
    }
    .nav-item:hover { background: #1a1a1a; }
    .back-btn {
      display: flex;
      align-items: center;
      padding: 16px;
      font-size: 18px;
      border-radius: 30px;
      margin-bottom: 8px;
      cursor: pointer;
      color: #fff;
      text-decoration: none;
    }
    .back-btn:hover { background: #1a1a1a; }
    .nav-icon { width: 28px; height: 28px; margin-right: 20px; }

    .main-content {
      flex: 1;
      max-width: 600px;
      border-right: 1px solid #2d2d2d;
    }
    .post-detail {
      padding: 20px;
      border-bottom: 1px solid #2d2d2d;
    }
    .post-row { display: flex; }
    .post-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #6644ff, #ff44aa);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 20px;
      margin-right: 16px;
      flex-shrink: 0;
    }
    .post-content { flex: 1; }
    .post-header { margin-bottom: 12px; }
    .post-name { font-weight: 700; font-size: 18px; margin-right: 8px; }
    .post-name-link { text-decoration: none; color: inherit; }
    .post-name-link:hover { text-decoration: underline; }
    .post-avatar-link { text-decoration: none; }
    .post-username { color: #666; }
    .post-time { color: #666; display: block; margin-top: 4px; font-size: 15px; }
    .post-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 16px;
    }
    .post-text {
      font-size: 18px;
      line-height: 1.6;
      white-space: pre-wrap;
    }
    .post-actions {
      display: flex;
      gap: 24px;
      padding: 16px 0;
      border-top: 1px solid #2d2d2d;
      margin-top: 20px;
    }
    .post-action { cursor: pointer; display: flex; align-items: center; gap: 8px; color: #666; }
    .post-action:hover { color: #fff; }

    .delete-btn {
      background: #f4212e;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 20px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="sidebar">
      <div class="logo">Threads</div>
      <a href="/" class="back-btn">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
        返回
      </a>
    </div>

    <div class="main-content">
      <div class="post-detail">
        <div class="post-row">
          <a href="/profile/<%= post.user_id %>" class="post-avatar-link">
            <div class="post-avatar"><%= post.username ? post.username.charAt(0).toUpperCase() : '?' %></div>
          </a>
          <div class="post-content">
            <div class="post-header">
              <a href="/profile/<%= post.user_id %>" class="post-name-link">
                <span class="post-name"><%= post.username %></span>
              </a>
              <span class="post-username">@<%= post.username ? post.username.toLowerCase() : '' %></span>
              <span class="post-time"><%= new Date(post.created_at).toLocaleString('zh-TW') %></span>
            </div>
            <h1 class="post-title"><%= post.title %></h1>
            <div class="post-text"><%= post.content %></div>
            <div class="post-actions">
              <div class="post-action">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
              </div>
              <div class="post-action">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17 3H7c-1.1 0-2 .9-2 2v16l7-3 7 3V5c0-1.1-.9-2-2-2z"/></svg>
              </div>
              <div class="post-action">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4h16v12H5.17L4 17.17V4m0-2c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2H4zm2 10h12v2H6v-2zm0-3h12v2H6V9zm0-3h12v2H6V6z"/></svg>
              </div>
            </div>
            <% if (canDelete) { %>
              <form action="/post/<%= post.id %>/delete" method="POST">
                <button type="submit" class="delete-btn" onclick="return confirm('確定刪除這則貼文？')">刪除</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>