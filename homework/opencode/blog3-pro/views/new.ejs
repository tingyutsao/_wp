<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>新增貼文 - Threads</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: #000;
      color: #fff;
      min-height: 100vh;
    }
    .container {
      display: flex;
      max-width: 1200px;
      margin: 0 auto;
      min-height: 100vh;
    }
    .sidebar {
      width: 280px;
      padding: 20px;
      position: sticky;
      top: 0;
      height: 100vh;
      border-right: 1px solid #2d2d2d;
    }
    .logo {
      font-size: 28px;
      font-weight: 700;
      padding: 20px 0 40px 10px;
      font-family: 'Georgia', serif;
    }
    .nav-item {
      display: flex;
      align-items: center;
      padding: 16px;
      font-size: 18px;
      border-radius: 30px;
      margin-bottom: 8px;
      cursor: pointer;
      transition: background 0.2s;
      text-decoration: none;
      color: #fff;
    }
    .nav-item:hover { background: #1a1a1a; }
    .back-btn {
      display: flex;
      align-items: center;
      padding: 16px;
      font-size: 18px;
      border-radius: 30px;
      margin-bottom: 8px;
      cursor: pointer;
      color: #fff;
      text-decoration: none;
    }
    .back-btn:hover { background: #1a1a1a; }
    .nav-icon { width: 28px; height: 28px; margin-right: 20px; }

    .main-content {
      flex: 1;
      max-width: 600px;
      border-right: 1px solid #2d2d2d;
    }
    .compose-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid #2d2d2d;
      position: sticky;
      top: 0;
      background: rgba(0,0,0,0.8);
      backdrop-filter: blur(10px);
    }
    .cancel-btn {
      background: none;
      border: none;
      color: #fff;
      font-size: 16px;
      cursor: pointer;
    }
    .post-btn {
      background: #fff;
      color: #000;
      border: none;
      padding: 10px 24px;
      border-radius: 20px;
      font-weight: 700;
      cursor: pointer;
    }
    .post-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .compose-area { padding: 20px; }
    .compose-row { display: flex; }
    .compose-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #6644ff, #ff44aa);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 20px;
      margin-right: 16px;
      flex-shrink: 0;
    }
    .compose-form { flex: 1; }
    .compose-input {
      width: 100%;
      background: transparent;
      border: none;
      color: #fff;
      font-size: 20px;
      outline: none;
      margin-bottom: 20px;
    }
    .compose-input::placeholder { color: #666; }
    .compose-textarea {
      width: 100%;
      background: transparent;
      border: none;
      color: #fff;
      font-size: 18px;
      outline: none;
      resize: none;
      min-height: 300px;
      line-height: 1.6;
    }
    .compose-textarea::placeholder { color: #666; }
  </style>
</head>
<body>
  <div class="container">
    <div class="sidebar">
      <div class="logo">Threads</div>
      <a href="/" class="back-btn">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
        返回
      </a>
    </div>

    <div class="main-content">
      <div class="compose-header">
        <button class="cancel-btn" onclick="window.location='/'">取消</button>
        <button type="submit" form="post-form" class="post-btn" id="post-btn">發布</button>
      </div>
      <div class="compose-area">
        <form id="post-form" action="/posts" method="POST">
          <div class="compose-row">
            <div class="compose-avatar"><%= user ? user.username.charAt(0).toUpperCase() : '?' %></div>
            <div class="compose-form">
              <input type="text" name="title" class="compose-input" placeholder="標題" required>
              <textarea name="content" class="compose-textarea" placeholder="分享你的想法..." required></textarea>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>